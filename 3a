import 'package:flutter/material.dart';

void main() {
  runApp(const ResponsiveApp());
}

class ResponsiveApp extends StatelessWidget {
  const ResponsiveApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Responsive UI',
      theme: ThemeData(
        primarySwatch: Colors.blue,
      ),
      home: const ResponsiveHomePage(),
    );
  }
}

class ResponsiveHomePage extends StatelessWidget {
  const ResponsiveHomePage({super.key});

  // Breakpoints
  static const double mobileBreakpoint = 600;
  static const double tabletBreakpoint = 1024;

  @override
  Widget build(BuildContext context) {
    // Get screen size using MediaQuery
    final mediaQuery = MediaQuery.of(context);
    final double width = mediaQuery.size.width;
    final double height = mediaQuery.size.height;

    // Check orientation
    final Orientation orientation = mediaQuery.orientation;

    // Select layout based on screen width
    Widget layout;

    if (width < mobileBreakpoint) {
      layout = const MobileLayout();
    } else if (width < tabletBreakpoint) {
      layout = const TabletLayout();
    } else {
      layout = const DesktopLayout();
    }

    return Scaffold(
      appBar: AppBar(
        title: const Text('Responsive Flutter UI'),
        centerTitle: true,
      ),
      body: Column(
        children: [
          // Screen information
          Container(
            width: double.infinity,
            padding: const EdgeInsets.all(12),
            color: Colors.blue.shade50,
            child: Column(
              children: [
                Text(
                  'Screen: ${width.toStringAsFixed(0)} × '
                  '${height.toStringAsFixed(0)}',
                  style: const TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                Text(
                  'Orientation: '
                  '${orientation == Orientation.portrait ? "Portrait" : "Landscape"}',
                  style: const TextStyle(fontSize: 15),
                ),
              ],
            ),
          ),

          // Selected responsive layout
          Expanded(
            child: layout,
          ),
        ],
      ),
    );
  }
}

// ---------------------------------------------------------
// MOBILE LAYOUT
// ---------------------------------------------------------

class MobileLayout extends StatelessWidget {
  const MobileLayout({super.key});

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        children: [
          const Text(
            'Mobile Layout',
            style: TextStyle(
              fontSize: 24,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 20),

          buildCard(
            Icons.phone_android,
            'Mobile',
            'Optimized for small screens',
            Colors.blue,
          ),

          buildCard(
            Icons.touch_app,
            'Touch Friendly',
            'Large buttons for easy interaction',
            Colors.green,
          ),

          buildCard(
            Icons.screen_rotation,
            'Orientation',
            'Supports portrait and landscape',
            Colors.orange,
          ),
        ],
      ),
    );
  }
}

// ---------------------------------------------------------
// TABLET LAYOUT
// ---------------------------------------------------------

class TabletLayout extends StatelessWidget {
  const TabletLayout({super.key});

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.all(20),
      child: Column(
        children: [
          const Text(
            'Tablet Layout',
            style: TextStyle(
              fontSize: 28,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 20),

          // Flexible allows cards to share available space.
          Row(
            children: [
              Flexible(
                child: buildCard(
                  Icons.tablet,
                  'Tablet',
                  'Medium screen layout',
                  Colors.purple,
                ),
              ),

              const SizedBox(width: 15),

              Flexible(
                child: buildCard(
                  Icons.dashboard,
                  'Dashboard',
                  'More content displayed',
                  Colors.teal,
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}

// ---------------------------------------------------------
// DESKTOP LAYOUT
// ---------------------------------------------------------

class DesktopLayout extends StatelessWidget {
  const DesktopLayout({super.key});

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.all(30),
      child: Column(
        children: [
          const Text(
            'Desktop Layout',
            style: TextStyle(
              fontSize: 32,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 25),

          // Expanded divides the available horizontal space.
          Expanded(
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                Expanded(
                  flex: 1,
                  child: buildCard(
                    Icons.computer,
                    'Desktop',
                    'Large screen layout',
                    Colors.indigo,
                  ),
                ),

                const SizedBox(width: 20),

                Expanded(
                  flex: 1,
                  child: buildCard(
                    Icons.analytics,
                    'Analytics',
                    'Detailed information',
                    Colors.deepOrange,
                  ),
                ),

                const SizedBox(width: 20),

                Expanded(
                  flex: 1,
                  child: buildCard(
                    Icons.settings,
                    'Settings',
                    'Additional options',
                    Colors.green,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

// ---------------------------------------------------------
// COMMON CARD WIDGET
// ---------------------------------------------------------

Widget buildCard(
  IconData icon,
  String title,
  String description,
  Color color,
) {
  return Card(
    elevation: 5,
    margin: const EdgeInsets.symmetric(vertical: 8),
    child: Container(
      padding: const EdgeInsets.all(20),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            icon,
            size: 50,
            color: color,
          ),

          const SizedBox(height: 15),

          Text(
            title,
            style: TextStyle(
              fontSize: 20,
              fontWeight: FontWeight.bold,
              color: color,
            ),
          ),

          const SizedBox(height: 8),

          Text(
            description,
            textAlign: TextAlign.center,
            style: const TextStyle(
              fontSize: 15,
            ),
          ),
        ],
      ),
    ),
  );
}
